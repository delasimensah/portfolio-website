# Supabase Configuration
# Copy this file to .env.local and fill in your values
# Get these values from 'yarn supabase:start' output

# Supabase URL
# For iOS Simulator and physical devices: http://127.0.0.1:54321
# For Android Emulator: http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 

# Supabase Anonymous Key
# Get this from 'yarn supabase:start' output (anon key)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
